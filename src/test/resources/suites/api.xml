<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.sdet.listeners.TestListeners"/>
        <listener class-name="com.sdet.listeners.RetryListener"/>
    </listeners>

    <test name="Auth API Tests">
        <classes>
            <class name="com.sdet.tests.api.AuthApiTest"/>
        </classes>
    </test>

    <test name="Booking API Tests">
        <classes>
            <class name="com.sdet.tests.api.BookingApiTest"/>
        </classes>
    </test>
</suite>