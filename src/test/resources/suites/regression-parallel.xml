<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite - Parallel" verbose="1"
       parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="com.sdet.listeners.TestListener"/>
        <listener class-name="com.sdet.listeners.RetryListener"/>
    </listeners>

    <test name="Chrome - UI Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.sdet.tests.LoginTest"/>
            <class name="com.sdet.tests.RegistrationTest"/>
        </classes>
    </test>

    <test name="Firefox - UI Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.sdet.tests.LoginTest"/>
            <class name="com.sdet.tests.RegistrationTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="com.sdet.tests.api.AuthApiTest"/>
            <class name="com.sdet.tests.api.BookingApiTest"/>
        </classes>
    </test>
</suite>