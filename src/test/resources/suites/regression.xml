<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1">
    <listeners>
            <listener class-name="com.sdet.listeners.TestListeners"/>
            <listener class-name="com.sdet.listeners.RetryListener"/>
    </listeners>

    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.sdet.tests.*"/>
        </packages>
    </test>
</suite>